# Save data (per-player state, not part of the game's source)
/save/

# OS / editor junk
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# Test run artifacts (tests/run.sh output and the screenshots individual tests save next to
# themselves or in their own subfolder; all regenerated every run, none of it is the test itself)
/tests/out_*.txt
/tests/results.txt
/tests/results_p*.txt
/tests/*.log
/tests/edge_profile_*/
/tests/*.png
/tests/*/*.png
# (tests/watki_test.js makes it each run: the texts' file changed, served to the game instead of the real one)
/tests/watki/nakladka/

# the marathon's report and log (regenerated every run) and the phone notification settings (a private ntfy topic)
/tests/marathon/raport.md
/tests/marathon/run.log
/tests/marathon/notify.json
/tests/autopilot/*.log
/tests/autopilot/*.jpg

# Python caches of the tool scripts, and the tavern generator's regenerated renders / install preview (a copy of data/)
__pycache__/
*.pyc
/tools/tavern/staging/renders/
/tools/tavern/staging/install_preview/

# every test's last result (tests/run.js, the 'before' column) - per machine, rewritten by every run
/tests/last_results.json

# the Winlu tileset author's sample maps (the pack's free demo from itch.io) - reference only, not ours to publish
/tools/town/winlu_samples/
# the town generator's regenerated overlay renders, and the reference pictures of the Winlu author's sample maps (not ours to publish)
/tools/town/staging/overlay_*/
/tools/town/refs/
.claude/settings.local.json
# the tavern v2 generator's regenerated renders and the test overlay (copies of data/ and img/ for GAME_OVERLAY)
/tools/tavern/v2/out/
/tools/tavern/v2/overlay/

# screenshots the newer tests save under their own folder (tests/<name>/shots/), stray test pictures in the root,
# and the art backups kept next to the work (the archive Tawerna_archiwum_* holds the real copies)
/tests/*/shots/
/*.png
/backup_art_*/

# tests/run.js: the session markers (`znacznik` - the files as they were, for `zmiany --od znacznik`) and the map's lock
/tests/znaczniki/
/tests/mapa_testow.json.lock
# the test map (tests/lib/mapa.js): per machine, like last_results.json - the texts of its measured versions are objects in this
# machine's .git (git hash-object -w), not in any commit; 1-5 MB, rewritten by every measurement
/tests/mapa_testow.json
